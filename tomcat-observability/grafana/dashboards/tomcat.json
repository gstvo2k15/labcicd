    {
      "id": 28,
      "title": "Logs de Tomcat",
      "description": "Tomcat access and JUL logs from Loki. Log search filters literal text. Job/Instance/Protocol select JMX metrics only; logs cover the single Tomcat service in this Compose.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"tomcat\"} |~ `${log_search:regex}`",
          "queryType": "range",
          "editorMode": "code",
          "maxLines": 1000
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
